APP_ENV=development
APP_NAME=NEXUS API
APP_VERSION=0.18.0
API_V1_PREFIX=/api/v1
SECRET_KEY=nexus-dev-secret-key-change-before-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local development works without Docker using SQLite.
DATABASE_URL=sqlite:///./data/nexus.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BODY_BYTES=26214400
ENABLE_DOCS_IN_PRODUCTION=false
ENABLE_METRICS_ENDPOINT=true

# Docker/PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://nexus:nexus_dev_password@localhost:5432/nexus

REDIS_ENABLED=true
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_WORKER_POLL_SECONDS=2.0
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
IMPORT_MAX_BYTES=20971520
PLAYWRIGHT_ALLOWED_HOSTS=
PLAYWRIGHT_TIMEOUT_MS=30000

# Intelligence / AI Gateway
AI_PROVIDER=mock
AI_MODEL=nexus-mock-1
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_MAX_TOOL_CALLS=5
AI_MAX_OUTPUT_TOKENS=1200
AI_FALLBACK_TO_MOCK=true
